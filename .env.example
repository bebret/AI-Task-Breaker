# ==== AI Provider ====
# --- Opsi A: OpenRouter (bisa akses DeepSeek, GLM, dll) ---
# API key dari https://openrouter.ai/keys
# Pilih model yang provider-nya diizinkan di akunmu
# (https://openrouter.ai/settings/privacy). Mis. akun dengan allowed
# provider "relace" bisa pakai deepseek/deepseek-v4.1-flash.
AI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=deepseek/deepseek-v4.1-flash
AI_BASE_URL=https://openrouter.ai/api/v1

# --- Opsi B: DeepSeek langsung ---
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com

# --- Opsi C: GLM (Zhipu) ---
# AI_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx
# AI_MODEL=glm-4-plus
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Port server (Hugging Face Spaces memakai 7860)
PORT=7860
